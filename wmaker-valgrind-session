#!/usr/bin/env bash
set -euo pipefail

WM_PREFIX="/opt/wmaker"
export PATH="${WM_PREFIX}/bin:${PATH}"
export LD_LIBRARY_PATH="${WM_PREFIX}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
export XDG_DATA_DIRS="${WM_PREFIX}/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

# Directory dei log di Valgrind
LOG_DIR="${HOME}/.local/share/wmaker/logs"
mkdir -p "${LOG_DIR}"

TIMESTAMP="$(date +'%Y%m%d_%H%M%S')"
VALGRIND_LOG="${LOG_DIR}/valgrind-wmaker-${TIMESTAMP}-%p.log"
WM_STDOUT_LOG="${LOG_DIR}/wmaker-${TIMESTAMP}.log"

# Opzioni consigliate per Valgrind con un Window Manager X11:
# - tracciamento errori di memoria e leak
# - segui i processi figli con --trace-children=yes ma salta i programmi esterni (/bin, /usr)
#   cosicché sia il processo monitor che il processo wmaker effettivo (--for-real) vengano analizzati
#TOOL="${VALGRIND_TOOL:-memcheck}"
#TOOL="${VALGRIND_TOOL:-callgrind}"
TOOL="${VALGRIND_TOOL:-massif}"

# Supporta anche il passaggio del tool tramite argomento CLI (es. --callgrind o --tool=callgrind).
# --callgrind-lazy registra solo dopo callgrind_control -i on <pid>: e' la modalita' per
# profilare un singolo scenario (20 cambi workspace) senza l'avvio dentro il dump.
if [[ "${1:-}" =~ ^--tool=(.*)$ ]]; then
    TOOL="${BASH_REMATCH[1]}"
    shift
elif [[ "${1:-}" =~ ^--(callgrind|callgrind-lazy|massif|dhat|memcheck|cachegrind|helgrind)$ ]]; then
    TOOL="${BASH_REMATCH[1]}"
    shift
fi

if [[ "${TOOL}" == "callgrind" ]]; then
    VALGRIND_OPTS=(
        --tool=callgrind
        --callgrind-out-file="${LOG_DIR}/callgrind-wmaker-${TIMESTAMP}-%p.out"
        --collect-jumps=yes
        --trace-children=yes
        --trace-children-skip="/bin/*,/sbin/*,/usr/*,/tmp/*,/var/*,/home/*,/etc/*,/lib*,/opt/*,!${WM_PREFIX}/bin/wmaker"
        --log-file="${VALGRIND_LOG}"
    )
# Promemoria (SpecAI 130): per sapere cosa costa davvero Alt+1..6, avviare con
# --callgrind --instr-atstart=no, poi callgrind_control -i on <pid>, cambiare
# workspace (xdotool key alt+2), callgrind_control --dump=ws e annotare <out>.1.
# same as callgrind, but collection starts only on callgrind_control -i on:
# nothing is recorded until then, so the dump holds the scenario alone.
elif [[ "${TOOL}" == "callgrind-lazy" ]]; then
    VALGRIND_OPTS=(
        --tool=callgrind
        --callgrind-out-file="${LOG_DIR}/callgrind-wmaker-${TIMESTAMP}-%p.out"
        --instr-atstart=no
        --collect-jumps=yes
        --trace-children=yes
        --trace-children-skip="/bin/*,/sbin/*,/usr/*,/tmp/*,/var/*,/home/*,/etc/*,/lib*,/opt/*,!${WM_PREFIX}/bin/wmaker"
        --log-file="${VALGRIND_LOG}"
    )
elif [[ "${TOOL}" == "cachegrind" ]]; then
    VALGRIND_OPTS=(
        --tool=cachegrind
        --cachegrind-out-file="${LOG_DIR}/cachegrind-wmaker-${TIMESTAMP}-%p.out"
        --trace-children=yes
        --trace-children-skip="/bin/*,/sbin/*,/usr/*,/tmp/*,/var/*,/home/*,/etc/*,/lib*,/opt/*,!${WM_PREFIX}/bin/wmaker"
        --log-file="${VALGRIND_LOG}"
    )
elif [[ "${TOOL}" == "helgrind" ]]; then
    VALGRIND_OPTS=(
        --tool=helgrind
        --trace-children=yes
        --trace-children-skip="/bin/*,/sbin/*,/usr/*,/tmp/*,/var/*,/home/*,/etc/*,/lib*,/opt/*,!${WM_PREFIX}/bin/wmaker"
        --log-file="${VALGRIND_LOG}"
    )
elif [[ "${TOOL}" == "massif" ]]; then
    VALGRIND_OPTS=(
        --tool=massif
        --massif-out-file="${LOG_DIR}/massif-wmaker-${TIMESTAMP}-%p.out"
        --alloc-fn=wmalloc
        --alloc-fn=wrealloc
        --alloc-fn=wstrdup
        --depth=16
        --threshold=0.5
        --pages-as-heap=yes
        --trace-children=yes
        --trace-children-skip="/bin/*,/sbin/*,/usr/*,/tmp/*,/var/*,/home/*,/etc/*,/lib*,/opt/*,!${WM_PREFIX}/bin/wmaker"
    )
elif [[ "${TOOL}" == "dhat" ]]; then
    VALGRIND_OPTS=(
        --tool=dhat
        --dhat-out-file="${LOG_DIR}/dhat-wmaker-${TIMESTAMP}-%p.out"
        --trace-children=yes
        --trace-children-skip="/bin/*,/sbin/*,/usr/*,/tmp/*,/var/*,/home/*,/etc/*,/lib*,/opt/*,!${WM_PREFIX}/bin/wmaker"
    )
else
    VALGRIND_OPTS=(
        --tool=memcheck
        --leak-check=full
        --show-leak-kinds=all
        --track-origins=yes
        --track-fds=yes
        --trace-children=yes
        --trace-children-skip="/bin/*,/sbin/*,/usr/*,/tmp/*,/var/*,/home/*,/etc/*,/lib*,/opt/*,!${WM_PREFIX}/bin/wmaker"
        --read-var-info=yes
        --num-callers=30
        --log-file="${VALGRIND_LOG}"
    )
fi

echo "Starting Window Maker under Valgrind (${TOOL}) supervision..." >> "${WM_STDOUT_LOG}"
echo "Valgrind log target: ${VALGRIND_LOG}" >> "${WM_STDOUT_LOG}"
date >> "${WM_STDOUT_LOG}"

exec valgrind "${VALGRIND_OPTS[@]}" "${WM_PREFIX}/bin/wmaker" "$@" >> "${WM_STDOUT_LOG}" 2>&1
